{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:games": "VITE_SITE=games vite",
    "build": "tsc -b && vite build",
    "build:native": "tsc -b && vite build --mode native && cap sync",
    "build:native:games": "tsc -b && vite build --mode native-games && CAP_APP=games cap sync",
    "cap:games": "CAP_APP=games cap",
    "cap:games:sync": "CAP_APP=games cap sync",
    "cap:games:add:ios": "CAP_APP=games cap add ios",
    "cap:games:add:android": "CAP_APP=games cap add android",
    "cap:games:open:ios": "CAP_APP=games cap open ios",
    "cap:games:open:android": "CAP_APP=games cap open android",
    "native:games:create": "bash scripts/create-games-native.sh",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "8.5.1",
    "@capacitor-firebase/messaging": "8.5.1",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@chakra-ui/react": "^3.28.0",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@tanstack/query-sync-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.13.1",
    "date-fns": "^3.6.0",
    "firebase": "^12.12.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.9.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-datepicker": "^7.5.0",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.1.2",
    "react-joyride": "^2.9.3",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.5"
  },
  "overrides": {
    "react-joyride": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  },
  "allowScripts": {
    "@firebase/util@1.15.0": true,
    "esbuild@0.25.11": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.5.5": true
  }
