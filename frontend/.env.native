VITE_API_URL=https://bela-turniri.com/api
VITE_WS_ORIGIN=wss://bela-turniri.com
VITE_NATIVE=1

# Same keys as .env.example, deliberately EMPTY so a native build never
# silently inherits a web-only value: Places falls back to Nominatim and the
# maps use the default CARTO tiles (watermarked without VITE_CARTO_API_KEY) unless these are filled in here.
# A key used from the Capacitor shell must allow `capacitor://localhost/*`
# and `https://localhost/*` in its Google Cloud website restrictions.
# Set the real key in .env.native.local (git-ignored; Vite loads it in
# --mode native). Never commit a key here — this file IS tracked.
VITE_GOOGLE_MAPS_API_KEY=
VITE_CARTO_API_KEY=
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Basemap provider: empty = CARTO raster (default). Set to "openfreemap" for
# keyless MapLibre GL vector tiles; styles default to liberty (light) / dark.
# The ~1 MB MapLibre renderer is lazily loaded and only downloaded when this
# is actually set, so leaving it empty costs a native build nothing.
VITE_MAP_PROVIDER=
VITE_OPENFREEMAP_STYLE=
VITE_OPENFREEMAP_STYLE_DARK=
