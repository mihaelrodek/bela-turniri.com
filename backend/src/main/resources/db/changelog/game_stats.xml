<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
          http://www.liquibase.org/xml/ns/dbchangelog
          https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!--
      Player statistics for the online Bela game (game/README.md §8).

      The Node game server (`game/`) holds nothing persistent: at GAME_OVER it
      reports the finished game here over an internal, non-public endpoint. It
      also owns the counting rule (§8.1 — a game counts only when BOTH teams
      contain at least one human), so the backend records everything it is
      handed and filters nothing.

      Two tables, not one aggregate table: statistics are ALWAYS computed by
      query (GROUP BY target_score, and unfiltered for the global row). A
      denormalised counter column would be one more thing that can silently
      drift out of sync with the rows it summarises, and there is no traffic
      volume here that would justify that risk.

      `game_results.uuid` is UNIQUE and that index IS the idempotency gate,
      exactly like `processed_operations.client_op_id`. The reporter mints the
      uuid once per finished game and retries with the SAME value when the
      connection drops mid-response, so a replay must insert nothing — the
      write path uses INSERT … ON CONFLICT (uuid) DO NOTHING and answers
      `{"recorded": false}` when it loses.

      `won` is denormalised onto the player row (it is always
      `team = winner_team`) so the stats query never has to carry the parent's
      winner_team through the GROUP BY — the whole read is one index scan on
      uid plus a join to fetch target_score.

      Indexes:
        * game_result_players(uid) — the only filter the read side ever
          applies. The per-category GROUP BY cannot be folded into a composite
          index here because `target_score` lives on the PARENT row; Postgres
          resolves that side through the unique (game_result_id, seat) index
          below, whose leading column is the FK, so no separate FK index is
          needed (Postgres does not create one automatically for a REFERENCES
          clause, and the ON DELETE CASCADE would otherwise seq-scan).
        * UNIQUE (game_result_id, seat) — a game has exactly one player per
          seat; also serves as the FK / cascade index described above.

      tableExists / MARK_RAN so a database where these were created by hand is
      a no-op rather than a startup failure.
    -->

    <changeSet id="2026-09-08-game-stats" author="mrodek">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="game_results"/>
            </not>
        </preConditions>

        <createTable tableName="game_results">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- Idempotency key, generated by the reporting game server. -->
            <column name="uuid" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="played_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <!-- Category: 501 | 701 | 1001 (game/README.md §8.2). -->
            <column name="target_score" type="smallint">
                <constraints nullable="false"/>
            </column>
            <column name="winner_team" type="char(1)">
                <constraints nullable="false"/>
            </column>
            <column name="score_a" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="score_b" type="int">
                <constraints nullable="false"/>
            </column>
            <!-- Nullable: informational only, the reporter may omit it. -->
            <column name="deals_count" type="smallint"/>
        </createTable>

        <addUniqueConstraint tableName="game_results"
                             columnNames="uuid"
                             constraintName="uq_game_results_uuid"/>

        <sql>
            ALTER TABLE game_results
                ADD CONSTRAINT ck_game_results_target_score
                    CHECK (target_score IN (501, 701, 1001));
            ALTER TABLE game_results
                ADD CONSTRAINT ck_game_results_winner_team
                    CHECK (winner_team IN ('A', 'B'));
        </sql>

        <createTable tableName="game_result_players">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="game_result_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="seat" type="smallint">
                <constraints nullable="false"/>
            </column>
            <column name="team" type="char(1)">
                <constraints nullable="false"/>
            </column>
            <!-- Firebase UID; NULL for a bot. Same width as the other
                 uid columns in this schema (pairs.submitted_by_uid is 64),
                 widened to 128 per the §8.3 contract. -->
            <column name="uid" type="varchar(128)"/>
            <column name="is_bot" type="boolean">
                <constraints nullable="false"/>
            </column>
            <!-- Denormalised `team = winner_team`, see the note above. -->
            <column name="won" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="game_result_players"
                                 baseColumnNames="game_result_id"
                                 constraintName="fk_game_result_players_game_result"
                                 referencedTableName="game_results"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addUniqueConstraint tableName="game_result_players"
                             columnNames="game_result_id, seat"
                             constraintName="uq_game_result_players_game_seat"/>

        <createIndex tableName="game_result_players" indexName="idx_game_result_players_uid">
            <column name="uid"/>
        </createIndex>

        <sql>
            ALTER TABLE game_result_players
                ADD CONSTRAINT ck_game_result_players_seat
                    CHECK (seat BETWEEN 0 AND 3);
            ALTER TABLE game_result_players
                ADD CONSTRAINT ck_game_result_players_team
                    CHECK (team IN ('A', 'B'));
        </sql>
    </changeSet>
</databaseChangeLog>
