# Vite env for the GAMES-ONLY native app (bela.games / Bela Games).
#
# Loaded by `vite build --mode native-games` (npm run build:native:games).
# Vite picks env files by MODE NAME, so `--mode native-games` does NOT read
# .env.native — this file has to carry every key .env.native carries, and the
# two must be kept in step by hand when a key is added to either.

# The games app talks to bela.games, not bela-turniri.com: one product, one
# host, one TLS certificate, and nothing in the binary that points at the
# tournaments brand. It is the SAME Quarkus backend and the SAME game server
# behind it — Caddy's bela.games site block proxies /api and /ws to exactly
# the same upstreams as bela-turniri.com does. The backend's CORS list needs
# no entry for this: a Capacitor WebView sends `capacitor://localhost` (iOS)
# or `https://localhost` (Android) as its Origin, both of which CORS_ORIGINS
# already allows, whichever host the request is addressed to.
VITE_API_URL=https://bela.games/api
VITE_WS_ORIGIN=wss://bela.games
VITE_NATIVE=1

# Forces src/site.ts into games mode at build time. This is the whole reason
# a separate mode exists: the shell runs on `capacitor://localhost` and has no
# hostname for site.ts to sniff, so the WEB build's hostname fallback cannot
# work here and the product has to be baked into the bundle.
VITE_SITE=games

# Same keys as .env.native, deliberately EMPTY. The games app has no map,
# no calendar and no tournament pages at all (src/site.ts
# FULL_SITE_ONLY_PREFIXES), so none of these should ever need a value —
# they are listed only so a missing key is a visible blank rather than a
# silent inherit from .env. Set anything real in .env.native-games.local
# (git-ignored via the root .gitignore's `.env.*.local`; Vite loads it in
# --mode native-games). Never commit a key here — this file IS tracked.
VITE_GOOGLE_MAPS_API_KEY=
VITE_CARTO_API_KEY=
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

VITE_MAP_PROVIDER=
VITE_OPENFREEMAP_STYLE=
VITE_OPENFREEMAP_STYLE_DARK=
