<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- allowBackup="false" + the two rule files: the app's entire local state
         is credentials (Firebase Auth session, FCM token / Installations id)
         and caches of server-owned data, none of which is safe or useful to
         clone onto another device. allowBackup alone does not cover Android
         12+ device-to-device transfer, hence dataExtractionRules; and
         fullBackupContent keeps the same exclusions honest on API 23-30.
         Full reasoning in res/xml/data_extraction_rules.xml.
         localeConfig: per-app language picker (API 33+), hr + sl. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="33">

        <!-- android:windowSoftInputMode is spelled out rather than left to the
             platform default. At targetSdk 35+ `adjustResize` is what an
             edge-to-edge window gets anyway, and it is the only mode under
             which Capacitor 8's SystemBars IME handling makes sense: it pads
             the WebView's parent by the IME inset and reports
             `safe-area-inset-bottom: 0` while the keyboard is up
             (@capacitor/android .../plugin/SystemBars.java). `adjustPan` would
             slide the whole window up instead, leaving `100dvh` and every
             `position: fixed` bar wrong. Named here so an OEM or a future
             targetSdk cannot quietly pick the other one. -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (Android's half of Universal Links). autoVerify
                 makes Android check /.well-known/assetlinks.json on
                 bela-turniri.com at install time; once verified, these
                 https:// links open MainActivity directly instead of the
                 chooser. Mirrors the four AASA path groups served at
                 ops/well-known/apple-app-site-association / the Caddyfile's
                 /.well-known/* handlers - see NativeShell.tsx's appUrlOpen
                 listener for where the resulting Intent.data ends up. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bela-turniri.com" />
                <data android:pathPrefix="/turniri/" />
                <data android:pathPrefix="/blok/" />
                <data android:pathPrefix="/igra/" />
                <data android:pathPrefix="/profil/" />
            </intent-filter>

            <!-- N5.4: static app shortcuts, shown on long-press of the
                 launcher icon. See res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- N5.3: "Nadolazeći turniri" home-screen widget. Not exported —
             the system delivers APPWIDGET_UPDATE to this app's own receiver
             by explicit package, so no other app needs to reach it directly.
             See UpcomingTournamentsWidgetProvider.kt / TournamentsWidgetWorker.kt. -->
        <receiver
            android:name=".widget.UpcomingTournamentsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/upcoming_tournaments_widget_info" />
        </receiver>

        <!-- FCM messages carry `channel_id: "bela"` (see FcmSender, backend);
             this tells the FCM SDK which channel to file a notification under
             when the JS side hasn't created one yet (e.g. a notification
             delivered before the WebView has ever run NativeShell's
             createChannel call). NativeShell.tsx still creates the real
             channel with its i18n display name on every native launch — this
             meta-data only supplies the id so FCM never falls back to its own
             unnamed default channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bela" />

        <!-- Small icon + accent for notifications the FCM SDK builds itself
             (a `notification` payload arriving while the app is backgrounded
             or killed — our own BelaMessagingService/LiveGameNotification
             path sets the same two explicitly). Without these FCM falls back
             to android:icon, i.e. the full-colour launcher icon, which the
             status bar masks into a white blob. ic_stat_bela is
             white-on-transparent by design. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_bela" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- N4.4: @capacitor-firebase/messaging registers its own
             FirebaseMessagingService (io.capawesome...MessagingService) for the
             com.google.firebase.MESSAGING_EVENT intent, and Android only ever
             delivers that intent to a single declared service. BelaMessagingService
             subclasses the plugin's service (calls super.onMessageReceived() for
             everything, see BelaMessagingService.kt) so JS-side push handling is
             unaffected; here the plugin's own entry is removed by exact
             android:name (the merger keys <service> by that attribute, and our
             subclass necessarily has a different one so a same-name "replace"
             isn't possible) and our subclass is registered in its place. -->
        <service
            android:name="io.capawesome.capacitorjs.plugins.firebase.messaging.MessagingService"
            tools:node="remove" />
        <service
            android:name=".BelaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Cancels the ongoing "partija uživo" notification when the user
             swipes the app off the recents screen. An Activity gets no
             callback for that; a started Service's onTaskRemoved() does.
             Deliberately stopWithTask="false" — with "true" the service is
             torn down WITHOUT onTaskRemoved() ever running, which is the
             whole point of it. Not exported: only this app starts it, and
             only from the foreground (see LiveGameTaskWatcherService.kt). -->
        <service
            android:name=".LiveGameTaskWatcherService"
            android:exported="false"
            android:stopWithTask="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 "Live Updates": without this the ongoing ProgressStyle
         notification posted by LiveGameNotification is never PROMOTED to the
         status-bar chip / always-on lock-screen card, no matter what
         setRequestPromotedOngoing() says. Install-time permission, no runtime
         prompt; the user can still demote it in Settings. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- NO LOCATION PERMISSION, on purpose (owner decision, 2026-09-20).
         The only geolocation consumer in the web app is hooks/useUserLocation.ts,
         reached exclusively from the tournaments calendar/map ("turniri u
         blizini"); the shipping native app is Bela Games, which has neither
         screen (src/site.ts FULL_SITE_ONLY_PREFIXES). A declared
         ACCESS_COARSE_LOCATION would have to be disclosed in Play's Data
         safety form for a capability the shipped binary never exercises.
         If a native tournaments build is ever revived, re-add
         <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
         here (COARSE only — see git history for why not FINE). -->

    <!-- Feature declarations -->

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
</manifest>
