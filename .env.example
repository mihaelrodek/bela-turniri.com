# Copy to `.env` and fill in real values.
# Anything without a default in backend/src/main/resources/application.properties
# MUST be set here, otherwise the Quarkus app will fail to start.

# ── CORS ───────────────────────────────────────────────────────────────
# Prod allow-list for the Quarkus API. Besides the website's own origins it
# MUST list the two native shells, or the iOS/Android apps get a CORS wall on
# every request: the iOS WebView serves the bundled app from the custom
# `capacitor://localhost` scheme, Android from `https://localhost`. Neither is
# a routable host, so listing them exposes nothing to the network.
# CORS_ORIGINS=https://bela-turniri.com,https://www.bela-turniri.com,capacitor://localhost,https://localhost
#
# Same two origins for the game server's WebSocket upgrade check, if you set it
# (unset = no Origin check at all; see game/packages/server/src/config.ts).
# GAME_CORS_ORIGINS=https://bela-turniri.com,capacitor://localhost,https://localhost

# ── Postgres (used by docker-compose + backend datasource) ─────────────
POSTGRES_DB=bela-turniri.com
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Optional override — defaults to jdbc:postgresql://localhost:5432/bela-turniri.com
# POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/bela-turniri.com

# ── MinIO (used by docker-compose + backend StorageService) ────────────
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=bela-posters

# Optional overrides — sensible localhost defaults exist in application.properties
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_PUBLIC_BASE_URL=http://localhost:9000

# ── Game server (bela online) ──────────────────────────────────────────
# Dev: allow anonymous game sessions for testing without Firebase auth.
GAME_DEV_ALLOW_ANON=1

# Shared secret the game server presents as `X-Internal-Token` when it reports
# a finished game to POST /api/internal/game-results. Must be IDENTICAL on the
# backend and the game server. Locally this matches the %dev,test fallback in
# application.properties, so `quarkus:dev` works whether or not it is exported.
# In production it must be a real random value (openssl rand -base64 32) — the
# backend WARNs at boot if it is missing or still set to this dev placeholder.
GAME_RESULTS_TOKEN=dev-secret-change-me

# ── Outgoing e-mail (Resend, used by the contact form) ─────────────────
# Leave blank locally: with no API key EmailService logs one line at boot
# and every send is a silent no-op, so the contact form still stores
# messages and the backend boots without a Resend account.
RESEND_API_KEY=
MAIL_FROM=
CONTACT_TO=

# ── Native push (Firebase Cloud Messaging) ─────────────────────────────
# Delivery path for the iOS/Android apps, ALONGSIDE the browsers' Web Push
# (VAPID_*) — a user with both gets both. Set ONE of the two; the inline JSON
# wins when both are present.
#
# How to get it: Firebase console → Project settings → Service accounts →
# "Generate new private key". It MUST be the SAME Firebase project as
# FIREBASE_PROJECT_ID (the project whose ID tokens the backend verifies) — a
# key from another project authenticates fine and then routes to nothing.
# It is a full admin credential for that project: never commit it.
#
# Leave both blank locally: FCM is then disabled, the backend boots normally,
# device tokens are still accepted and stored, and they start being delivered
# to the moment credentials appear. The backend WARNs once at boot in prod.
#
# The whole service-account JSON on one line (handy for a secret store):
FIREBASE_SERVICE_ACCOUNT_JSON=
# …or a path to the downloaded key file, readable by the backend container:
FIREBASE_SERVICE_ACCOUNT_FILE=
# Optional. Must match the notification channel the Android shell creates on
# first run, or Android 8+ silently drops every notification.
# FCM_ANDROID_CHANNEL_ID=bela
