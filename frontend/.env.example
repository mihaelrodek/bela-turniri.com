# Copy to `.env.local` and fill in real values (see `.gitignore`).
#
# Firebase web config — not secret per Firebase's docs (they identify the
# project, not authorize access). Real security comes from App Check +
# Auth domain restrictions in the Google Cloud console, plus server-side
# ID-token verification by the Quarkus backend. Still: lock this key down
# to your production domain(s) before launch.
VITE_FIREBASE_API_KEY=AIzaSyAlU3-tgNk4xxcPU0t4AHi5Se5XVXm1Gwg
VITE_FIREBASE_AUTH_DOMAIN=bela-turniri.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bela-turniri
VITE_FIREBASE_APP_ID=1:830530778451:web:a54d74d388506f5fc95da6

# Optional: override the API base URL.
# Defaults to "/api" — fine in dev (Vite proxy) and in prod when nginx
# serves the SPA and proxies /api/* to the backend on the same origin.
# Only set this when the backend lives on a different origin than the SPA.

# --- Google Places (New): location autocomplete on the create/edit form ---
# Leave EMPTY to fall back to OpenStreetMap Nominatim (keyless, no billing,
# noticeably worse at venue names like "Voćarna Bagrem").
#
# This key SHIPS IN THE JS BUNDLE by design — a browser-side Places call has
# nowhere to hide it. The ONLY protection is the restriction you set in Google
# Cloud: Application restriction "Websites" (your domains + capacitor://localhost)
# plus API restriction "Places API (New)" only. See DEPLOY.md.
VITE_GOOGLE_MAPS_API_KEY=

# --- Map tiles (Leaflet raster basemap) ---
# Both maps (/karta and the create-form picker) read these. Default is CARTO
# Voyager. CARTO now requires a (free) key or it watermarks every tile with
# "API KEY REQUIRED": request one at https://carto.com/basemaps/apikey (no
# account needed, 5 M tiles/month non-commercial) and put it here.
# To switch provider entirely set both of the next two, e.g. MapTiler:
#   VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#   VITE_MAP_TILE_ATTRIBUTION=<a href="https://www.maptiler.com/copyright/">MapTiler</a>
VITE_CARTO_API_KEY=
# Leaflet's {s} (subdomains) and {r} (retina @2x) placeholders are supported.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
