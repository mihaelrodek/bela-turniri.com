<?xml version="1.0" encoding="utf-8"?>
<!-- N5.3 widget row background: a slightly-tinted rounded rect so each of the
     up-to-three tournament rows reads as its own tap target. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_bg_row" />
    <corners android:radius="10dp" />
</shape>
