VITE_API_URL=https://bela-turniri.com/api
VITE_WS_ORIGIN=wss://bela-turniri.com
VITE_NATIVE=1

# Same keys as .env.example, deliberately EMPTY so a native build never
# silently inherits a web-only value: Places falls back to Nominatim and the
# maps use the default CARTO tiles (watermarked without VITE_CARTO_API_KEY) unless these are filled in here.
# A key used from the Capacitor shell must allow `capacitor://localhost/*`
# and `https://localhost/*` in its Google Cloud website restrictions.
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCLWPKeQHxBISHnvYRvUHF600hhk81J0hk
VITE_CARTO_API_KEY=
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
