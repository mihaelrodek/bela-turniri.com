<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (Android's half of Universal Links). autoVerify
                 makes Android check /.well-known/assetlinks.json on
                 bela-turniri.com at install time; once verified, these
                 https:// links open MainActivity directly instead of the
                 chooser. Mirrors the four AASA path groups served at
                 ops/well-known/apple-app-site-association / the Caddyfile's
                 /.well-known/* handlers - see NativeShell.tsx's appUrlOpen
                 listener for where the resulting Intent.data ends up. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bela-turniri.com" />
                <data android:pathPrefix="/turniri/" />
                <data android:pathPrefix="/blok/" />
                <data android:pathPrefix="/igra/" />
                <data android:pathPrefix="/profil/" />
            </intent-filter>

            <!-- N5.4: static app shortcuts, shown on long-press of the
                 launcher icon. See res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!-- N5.3: "Nadolazeći turniri" home-screen widget. Not exported —
             the system delivers APPWIDGET_UPDATE to this app's own receiver
             by explicit package, so no other app needs to reach it directly.
             See UpcomingTournamentsWidgetProvider.kt / TournamentsWidgetWorker.kt. -->
        <receiver
            android:name=".widget.UpcomingTournamentsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/upcoming_tournaments_widget_info" />
        </receiver>

        <!-- FCM messages carry `channel_id: "bela"` (see FcmSender, backend);
             this tells the FCM SDK which channel to file a notification under
             when the JS side hasn't created one yet (e.g. a notification
             delivered before the WebView has ever run NativeShell's
             createChannel call). NativeShell.tsx still creates the real
             channel with its i18n display name on every native launch — this
             meta-data only supplies the id so FCM never falls back to its own
             unnamed default channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bela" />

        <!-- N4.4: @capacitor-firebase/messaging registers its own
             FirebaseMessagingService (io.capawesome...MessagingService) for the
             com.google.firebase.MESSAGING_EVENT intent, and Android only ever
             delivers that intent to a single declared service. BelaMessagingService
             subclasses the plugin's service (calls super.onMessageReceived() for
             everything, see BelaMessagingService.kt) so JS-side push handling is
             unaffected; here the plugin's own entry is removed by exact
             android:name (the merger keys <service> by that attribute, and our
             subclass necessarily has a different one so a same-name "replace"
             isn't possible) and our subclass is registered in its place. -->
        <service
            android:name="io.capawesome.capacitorjs.plugins.firebase.messaging.MessagingService"
            tools:node="remove" />
        <service
            android:name=".BelaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- COARSE only. The "turniri u blizini" filter asks the browser API for
         `enableHighAccuracy: false` (hooks/useUserLocation.ts) — city-level is
         all it uses. Declaring FINE made Android 12+ offer "precise" and had to
         be disclosed as precise location in Play's Data safety form for a
         capability the app never exercises (store audit, 2026-09-13). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Feature declarations -->

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
</manifest>
