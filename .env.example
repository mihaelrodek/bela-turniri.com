# Copy to `.env` and fill in real values.
# Anything without a default in backend/src/main/resources/application.properties
# MUST be set here, otherwise the Quarkus app will fail to start.

# ── Postgres (used by docker-compose + backend datasource) ─────────────
POSTGRES_DB=bela-turniri.com
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Optional override — defaults to jdbc:postgresql://localhost:5432/bela-turniri.com
# POSTGRES_JDBC_URL=jdbc:postgresql://localhost:5432/bela-turniri.com

# ── MinIO (used by docker-compose + backend StorageService) ────────────
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_BUCKET=bela-posters

# Optional overrides — sensible localhost defaults exist in application.properties
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_PUBLIC_BASE_URL=http://localhost:9000

# ── Game server (bela online) ──────────────────────────────────────────
# Dev: allow anonymous game sessions for testing without Firebase auth.
GAME_DEV_ALLOW_ANON=1

# ── Outgoing e-mail (Resend, used by the contact form) ─────────────────
# Leave blank locally: with no API key EmailService logs one line at boot
# and every send is a silent no-op, so the contact form still stores
# messages and the backend boots without a Resend account.
RESEND_API_KEY=
MAIL_FROM=
CONTACT_TO=
