<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (Android's half of Universal Links). autoVerify
                 makes Android check /.well-known/assetlinks.json on
                 bela-turniri.com at install time; once verified, these
                 https:// links open MainActivity directly instead of the
                 chooser. Mirrors the four AASA path groups served at
                 ops/well-known/apple-app-site-association / the Caddyfile's
                 /.well-known/* handlers - see NativeShell.tsx's appUrlOpen
                 listener for where the resulting Intent.data ends up. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="bela-turniri.com" />
                <data android:pathPrefix="/turniri/" />
                <data android:pathPrefix="/blok/" />
                <data android:pathPrefix="/igra/" />
                <data android:pathPrefix="/profil/" />
            </intent-filter>

        </activity>

        <!-- FCM messages carry `channel_id: "bela"` (see FcmSender, backend);
             this tells the FCM SDK which channel to file a notification under
             when the JS side hasn't created one yet (e.g. a notification
             delivered before the WebView has ever run NativeShell's
             createChannel call). NativeShell.tsx still creates the real
             channel with its i18n display name on every native launch — this
             meta-data only supplies the id so FCM never falls back to its own
             unnamed default channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="bela" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Feature declarations -->

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
</manifest>
