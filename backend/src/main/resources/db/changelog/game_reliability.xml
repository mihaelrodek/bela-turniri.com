<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">
    <changeSet id="20260918-game-reliability" author="codex">
        <addColumn tableName="user_profiles">
            <column name="game_karma" type="int" defaultValueNumeric="100">
                <constraints nullable="false"/>
            </column>
            <column name="game_abandons" type="bigint" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createTable tableName="game_reliability_events">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_id" type="varchar(120)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_uid" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="game_reliability_events" indexName="idx_game_reliability_events_user_time">
            <column name="user_uid"/>
            <column name="occurred_at"/>
        </createIndex>
        <sql>ALTER TABLE game_reliability_events ADD CONSTRAINT ck_game_reliability_event_type CHECK (event_type = 'ABANDONED')</sql>
    </changeSet>
</databaseChangeLog>
